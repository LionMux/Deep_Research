# SciRAG environment configuration.
# Copy to ".env" and fill in the values you need. All keys are optional;
# SciRAG falls back gracefully between providers. Do NOT commit your real .env.

# ----------------------------------------------------------------------
# Primary LLM provider (OpenAI-compatible). Formerly "Kimi"/Moonshot.
# PRIMARY_* is the new naming; KIMI_*/MOONSHOT_* are kept for back-compat.
# ----------------------------------------------------------------------
PRIMARY_API_KEY=
PRIMARY_BASE_URL=
PRIMARY_MODEL_OUTLINE=
PRIMARY_MODEL_SYNTHESIS=
PRIMARY_MODEL_VERIFY=
PRIMARY_TEMPERATURE=0.3
# Local fallback (LM Studio / Ollama via OpenAI-compatible endpoint)
PRIMARY_FALLBACK_URL=
PRIMARY_FALLBACK_MODEL=

# Back-compat aliases (used only if PRIMARY_* is unset)
# KIMI_API_KEY=
# KIMI_BASE_URL=
# MOONSHOT_API_KEY=

# ----------------------------------------------------------------------
# Gemini fallback
# ----------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

# ----------------------------------------------------------------------
# Hugging Face Inference (used for the synthesize phase, gated by precheck)
# ----------------------------------------------------------------------
HF_API_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL_SYNTHESIS=
HF_PRECHECK_ENABLED=true
HF_PRECHECK_TIMEOUT_SEC=20

# ----------------------------------------------------------------------
# DeepInfra (OpenAI-compatible) alternative for the synthesize phase
# ----------------------------------------------------------------------
DEEPINFRA_API_TOKEN=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL_SYNTHESIS=
DEEPINFRA_ENABLED=true

# ----------------------------------------------------------------------
# Firecrawl deep-research (third_party/open-deep-research-w-firecrawl)
# ----------------------------------------------------------------------
FIRECRAWL_ENABLE_DEEP_RESEARCH=false
FIRECRAWL_DEEP_SEARCH_QUERY=
FIRECRAWL_MAX_RUNS=1
FIRECRAWL_TIMEOUT_SEC=180
FIRECRAWL_MAX_SECTIONS=8
FIRECRAWL_MAX_CHUNKS=12

# ----------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------
# Default papers directory for indexing/search
SCIRAG_PAPERS_DIR=./papers
